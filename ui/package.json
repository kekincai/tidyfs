{
  "name": "tidyfs-ui",
  "version": "0.2.1",
  "description": "tidyfs 的终端交互界面（Ink），后端是 Rust 写的 tidyfs 引擎。",
  "private": true,
  "type": "module",
  "bin": {
    "tidyfs-ui": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test \"dist/**/*.test.js\"",
    "format": "prettier --write src",
    "lint": "prettier --check src && tsc -p . --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "pino": "^10.4.0",
    "react": "^19.2.0",
    "string-width": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekincai/tidyfs.git",
    "directory": "ui"
  }
}
